# Void Crypto Trader - API keys (copy to api_keys.env)
# No quotes. Leave blank to skip. Paid keys: paste later — bot auto-picks.

# ===== Solana RPC (for wallet-copy / 0.1s loops) =====
# Priority: RPC_HTTP_URL > Helius > QuickNode > Alchemy > Chainstack > Triton > public

# Option A: paste a full RPC URL (any paid provider)
RPC_HTTP_URL=

# Option B: provider-specific (bot builds URL when possible)
# Helius  https://www.helius.dev/
HELIUS_API_KEY=
# HELIUS_RPC_URL=

# QuickNode  https://www.quicknode.com/  (paste full HTTPS endpoint)
QUICKNODE_RPC_URL=

# Alchemy  https://www.alchemy.com/
ALCHEMY_API_KEY=
# ALCHEMY_RPC_URL=

# Chainstack  https://chainstack.com/  (paste full HTTPS endpoint)
CHAINSTACK_RPC_URL=

# Triton / RPC Pool  https://triton.one/  (paid, paste full URL)
TRITON_RPC_URL=

# ===== Market / security (optional) =====
# FOMO API  https://fomoapi.io/dashboard
# Required for real FOMO memecoins (trending/most-held/graduated boards)
# https://fomoapi.io/dashboard
# Required for real FOMO memecoins (trending/most-held/graduated boards)
FOMOAPI_KEY=

# GoPlus honeypot  https://gopluslabs.io/
GOPLUS_API_KEY=

# Jupiter (optional price/swap)  https://station.jup.ag/
JUPITER_API_KEY=

# ===== Live wallet only (sim: leave empty) =====
SOLANA_PRIVATE_KEY=
TARGET_LEADER_WALLET=

# FOMO app session (advanced live)
FOMO_ACCESS_TOKEN=
FOMO_WALLET_ADDRESS=
FOMO_EMAIL=
FOMO_PASSWORD=
