# Void Crypto Trader - API keys
# Copy to api_keys.env and fill in. No quotes around values.
#
# FOMOAPI_KEY  -> https://fomoapi.io/dashboard
# GOPLUS_API_KEY -> https://gopluslabs.io/
# RPC_HTTP_URL -> https://www.helius.dev/  (or leave empty for public RPC)
# SOLANA_PRIVATE_KEY -> your wallet only for LIVE mode (leave empty for sim)

FOMOAPI_KEY=
GOPLUS_API_KEY=
RPC_HTTP_URL=
SOLANA_PRIVATE_KEY=

# Advanced FOMO live session (optional)
# FOMO app: https://fomo.family
FOMO_ACCESS_TOKEN=
FOMO_WALLET_ADDRESS=
FOMO_EMAIL=
FOMO_PASSWORD=

# ---- Phantom wallet / Jupiter live trading ----
# LIVE_TRADING must be "true" for ANY real-money swap (belt-and-braces with MODE=live)
LIVE_TRADING=false
# Key material: EITHER base58 key below, OR export Phantom key file to keys/phantom.json
SOLANA_PRIVATE_KEY=
PHANTOM_WALLET_FILE=
LIVE_TRADE_MAX_USD=200
LIVE_DAILY_LOSS_LIMIT_USD=300
LIVE_DAILY_VOLUME_CAP=1000
JUPITER_SLIPPAGE_BPS=100
LIVE_DRY_RUN=false
