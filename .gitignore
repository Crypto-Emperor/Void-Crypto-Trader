# Python compiled files
__pycache__/
*.pyc

# Secrets — never commit real keys (api_keys.env.example is the template)
keys/*.env
!**/api_keys.env.example
.env
phantom.json

# Logs and temporary state files
*.log
protections_state.json
session_meta.json
equity_history.json
price_history.json
# Built binaries & build artifacts (rebuild with Void.bat/Void.sh build)
VoidCryptoTrader.exe
VoidCryptoTrader-*
VoidCryptoTrader-Release/dist/
VoidCryptoTrader-Release/app/build/
VoidCryptoTrader-Release/app/*.spec
.void_deps_ok
*.pid
